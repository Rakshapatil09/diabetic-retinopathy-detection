def is_power_of_two(x):
    return x>0 and (x & (x - 1)) == 0
def count(arr):
    n=len(arr)
    result=0
    MOD=10**(9)+7
    for m in range(1,1<<n):
        product=1
        for i in range(n):
            if m &(1<<i):
                product*=arr[i]
        if is_power_of_two(product):
            result=(result+1)%MOD
    return result
arr=[2,3,4,8,16]
print("Answer:",count(arr))